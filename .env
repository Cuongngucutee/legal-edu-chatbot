# ═══════════════════════════════════════════════════
# LawEdu AI — Environment Configuration
# ═══════════════════════════════════════════════════

# --- LLM 320B API ---
LLM_API_BASE=https://api.int2.net/v1
LLM_API_KEY=
LLM_MODEL_NAME=glm-4.7
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- Redis (optional, fallback to in-memory) ---
REDIS_URL=redis://localhost:6379/0

# --- API Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=lawedu-default-key

# --- Data Paths ---
DATA_DIR=data/final
KG_PATH=outputs/knowledge_graph/entity_graph.json
